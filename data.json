{
  "pageSize": "Letter",
  "orientation": "portrait",
  "marginTopMm": 25,
  "marginRightMm": 20,
  "marginBottomMm": 25,
  "marginLeftMm": 20,
  "bodyFont": "Palatino, 'Palatino Linotype', serif",
  "bodySizePt": 11,
  "bodyLineHeight": 1.5,
  "paragraphSpacingEm": 0.8,
  "h1Font": "'Helvetica Neue', Helvetica, Arial, sans-serif",
  "h2Font": "Helvetica, Arial, sans-serif",
  "h3Font": "Helvetica, Arial, sans-serif",
  "h1SizePt": 22,
  "h2SizePt": 16,
  "h3SizePt": 13,
  "headingSpaceBeforeEm": 1.2,
  "headingSpaceAfterEm": 0.5,
  "pageBreakBeforeH1": true,
  "pageBreakOnHr": true,
  "codeFont": "Menlo, Consolas, monospace",
  "codeSizePt": 9,
  "showHeader": false,
  "headerText": "{{title}}",
  "headerAlign": "left",
  "showPageNumbers": false,
  "pageNumberFormat": "Page {page} of {pages}",
  "pageNumberAlign": "right",
  "headingFont": "'Helvetica Neue', Helvetica, Arial, sans-serif",
  "h1OverrideFont": false,
  "h2OverrideFont": false,
  "h3OverrideFont": false
}
